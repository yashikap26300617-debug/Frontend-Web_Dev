def calculate_simple_interest(P, R, T):
    SI = (P * R * T) / 100
    return SI


def main():
    P = float(input( ))
    R = float(input( ))
    T = float(input( ))

    SI = calculate_simple_interest(P, R, T)
    print(f"{SI:.2f}")






